# --- App ---
NODE_ENV=development
APP_PORT=5107
CORS_ORIGIN=http://localhost:5108

# --- Database ---
# sqlite | postgres | mysql
DATABASE_TYPE=sqlite

# SQLite only (resolved against the server working directory)
SQLITE_PATH=./data.db

# Postgres / MySQL: use a full URL, or fill in the parts below
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Logging ---
# Directory for the per-tag log files (resolved against the server working directory)
LOG_DIR=./logs

# --- Auth ---
# HS256 signing secret (at least 16 chars). When empty, an insecure dev-only
# secret is used and the built-in admin/admin account is active.
AUTH_JWT_SECRET=
# Token lifetime in seconds (default 604800 = 7 days)
AUTH_TOKEN_TTL=604800
